# Supabase (public anon key is safe for client; service role is server-only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Doly Stores

# Cloudflare R2 (optional — uploads skipped when unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Resend (optional — emails logged as not-configured when unset)
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@yourdomain.com
# Fallback only when settings.admin_notification_emails has not been saved yet.
# Comma-separated placeholders. After the first dashboard save, the database list is authoritative.
ADMIN_NOTIFICATION_EMAIL=admin@yourdomain.com,owner@yourdomain.com

# Google OAuth — configure in Supabase dashboard, not here
# Settings (stored in DB; these are fallbacks for dev)
NEXT_PUBLIC_WHATSAPP_NUMBER=
